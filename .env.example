# Discord Developer Portal bot token
DISCORD_TOKEN=put_your_bot_token_here

# Discord application ID (also called Client ID)
CLIENT_ID=put_your_application_id_here

# Your Discord server ID
GUILD_ID=put_your_server_id_here

# Render sets PORT automatically; local default is 3000
PORT=3000

# Render persistent disk mount path. Keep this as /var/data on Render.
DATA_DIR=/var/data